{
  "name": "etlingo-backend",
  "version": "1.0.0",
  "description": "Content & admin API for the EtLang Ethiopian language learning app",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:init": "node scripts/db-init.js",
